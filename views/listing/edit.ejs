<% layout("/layouts/boilerplate") %>
<style>
  footer {
    position: static;
  }
  label {
    font-weight: bold;
    font-size: 1.1rem;
  }
</style>
<div class="container">
  <form
    action="/listings/<%= listing._id %>?_method=PUT"
    method="post"
    novalidate
    class="needs-validation"
    enctype="multipart/form-data"
  >
    <div class="row mt-3">
      <div class="mb-3 col-12">
        <label for="title" class="form-label">Enter title:</label>
        <input
          type="text"
          placeholder="Enter title"
          value="<%= listing.title%>"
          name="title"
          class="form-control"
          required
        />
        <div class="valid-feedback">Title looks Good!</div>
        <div class="invalid-feedback">Title cannot be empty.</div>
      </div>
    </div>

    <div class="row">
      <div class="mb-3 col-12">
        <label for="description" class="form-label"
          >Enter description of the listing:</label
        >
        <input
          type="text"
          placeholder="Enter description"
          value="<%= listing.description%>"
          name="description"
          class="form-control"
          required
        />
        <div class="valid-feedback">Description looks Good!</div>
        <div class="invalid-feedback">Description cannot be empty.</div>
      </div>
    </div>

    <div class="row">
      <div class="mb-3 col-12">
        <h5>Current listing image:</h5>
        <img src="<%= listing.image.url%>" alt="" />
      </div>
    </div>

    <div class="row">
      <div class="mb-3 col-12">
        <label for="img" class="form-label">Upload new image:</label>
        <input
          type="file"
          name="image"
          value="<%= listing.image.url%>"
          class="form-control"
        />
        <div class="invalid-feedback">Please provide a correct image URL.</div>
      </div>
    </div>

    <div class="row">
      <div class="mb-3 col-md-4">
        <label for="price" class="form-label">Enter price per night:</label>
        <input
          type="number"
          placeholder="Enter price"
          name="price"
          value="<%= listing.price%>"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Enter valid Price.</div>
      </div>

      <div class="mb-3 col-md-8">
        <label for="loc" class="form-label">Enter location:</label>
        <input
          type="text"
          placeholder="Enter loaction"
          name="location"
          value="<%= listing.location%>"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Location is mandatory.</div>
      </div>
    </div>

    <div class="row">
      <div class="mb-3 col-12">
        <label for="country" class="form-label">Enter country:</label>
        <input
          type="text"
          placeholder="Enter country"
          name="country"
          value="<%= listing.country%>"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Country name is mandatory.</div>
      </div>
    </div>

    <button class="btn btn-outline-success mb-5 mt-2">Edit</button>
  </form>
</div>
