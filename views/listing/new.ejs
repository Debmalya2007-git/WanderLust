<% layout("/layouts/boilerplate") %>
<style>
  footer {
    position: static;
  }
  form {
    padding: 1.4rem;
  }
  label {
    font-weight: bold;
    font-size: 1.1rem;
  }
  .navbar {
    padding: 0 !important;
  }
</style>
<div class="container">
  <form
    action="/listings"
    method="post"
    class="needs-validation"
    novalidate
    enctype="multipart/form-data"
  >
    <div class="row">
      <div class="mb-3 col-12">
        <label for="title" class="form-label">Enter title:</label>
        <input
          type="text"
          placeholder="Title"
          name="title"
          id="title"
          class="form-control"
          required
        />
        <div class="valid-feedback">Title looks Good!</div>
        <div class="invalid-feedback">Title cannot be empty.</div>
      </div>
    </div>

    <div class="row">
      <div class="mb-3 col-12">
        <label for="description" class="form-label"
          >Enter description of the listing:</label
        >

        <input
          type="text"
          placeholder="Description"
          name="description"
          id="description"
          class="form-control"
          required
        />
        <div class="valid-feedback">Description looks Good!</div>
        <div class="invalid-feedback">Description cannot be empty.</div>
      </div>
    </div>

    <div class="row">
      <div class="mb-3 col-12">
        <label for="img" class="form-label">Upload listing image:</label>
        <input
          type="file"
          name="image"
          id="img"
          class="form-control"
          required
        />
      </div>
    </div>

    <div class="row">
      <div class="mb-3 col-4">
        <label for="price" class="form-label">Enter price per night:</label>
        <input
          type="number"
          placeholder="Price per night"
          name="price"
          id="price"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Enter valid Price.</div>
      </div>

      <div class="mb-3 col-8">
        <label for="loc" class="form-label">Enter location:</label>
        <input
          type="text"
          placeholder="Location"
          name="location"
          id="loc"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Location is mandatory.</div>
      </div>
    </div>

    <div class="row">
      <div class="mb-3 col-12">
        <label for="country" class="form-label">Enter country:</label>
        <input
          type="text"
          placeholder="Country"
          name="country"
          id="country"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Country name is mandatory.</div>
      </div>
    </div>
    <button class="btn btn-outline-success">Create</button>

    <br /><br />
  </form>
</div>
