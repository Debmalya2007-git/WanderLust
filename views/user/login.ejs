<% layout("/layouts/boilerplate") %>
<style>
  .move_top {
    display: none;
  }

  nav {
    display: none !important;
  }
</style>

<div class="container mt-4">
  <div class="row justify-content-center">
    <div
      class="col-12 col-sm-10 col-md-8 col-lg-6 shadow-sm bg-body-tertiary rounded p-4"
    >
      <div class="row">
        <h3>Welcome Back!</h3>
      </div>
      <div class="row">
        <h4 class="mb-4">Login to WanderLust</h4>
      </div>
      <form action="/login" method="post" class="needs-validation" novalidate>
        <div class="row">
          <div class="form-floating mb-3 col-12">
            <input
              type="text"
              class="form-control"
              id="floatingInput"
              placeholder="Username"
              name="username"
              required
            />
            <label for="floatingInput">Username</label>
            <div class="invalid-feedback">Provide your username</div>
          </div>
        </div>

        <div class="row">
          <div class="form-floating col-12">
            <input
              type="password"
              class="form-control"
              id="floatingPassword"
              placeholder="Password"
              name="password"
              required
            />
            <label for="floatingPassword">Password</label>
            <div class="invalid-feedback">Please provide a secure password</div>
          </div>
        </div>

        <button class="btn btn-success col-8 offset-2 mt-4">Log in</button>
      </form>
    </div>
  </div>
</div>
